      "parameters": {
        "jsCode": "const all=$input.all().map(x=>x.json); const input=all.find(x=>x.incident_id)||{}; const rows=all.filter(x=>x.incident_id); const current=rows[0]||input; const previous=Math.min(3,Number(current.nivel_escalamiento||input.nivel_escalamiento||0)); const next=Math.min(3,previous+1); const impacto=String(input.impacto||current.impacto||'').toUpperCase(); const channels=(impacto==='CRITICO'||impacto==='ALTO')?['EMAIL','TELEGRAM']:['EMAIL']; const reason=next===1?'Primer vencimiento del SLA':`Incidente continúa abierto después del escalamiento nivel ${previous}`; return [{json:{...input,...current,nivel_previo:previous,nivel_nuevo:next,canales:channels.join(', '),motivo:reason,estado_previo:current.estado||input.estado||'ABIERTO',estado_nuevo:'ABIERTO',fecha_escalamiento:new Date().toISOString()}}];"
      },
