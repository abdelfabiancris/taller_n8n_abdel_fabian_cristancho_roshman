    {
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst clean=v=>v===undefined||v===null?'':String(v).trim();\nconst digits=v=>clean(v).replace(/\\D/g,'');\nconst email=clean(r.email||r.Email).toLowerCase();\nreturn [{json:{\n  _origen:'entrada',\n  nombre:clean(r.nombre||r.Nombre),\n  apellido:clean(r.apellido||r.Apellido),\n  email,\n  telefono:digits(r.telefono||r.Telefono),\n  empresa:clean(r.empresa||r.Empresa),\n  nit:clean(r.nit||r.NIT),\n  ciudad:clean(r.ciudad||r.Ciudad),\n  fecha:clean(r.fecha||r.Fecha)||new Date().toISOString()\n}}];"
      },
