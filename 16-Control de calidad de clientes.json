      "name": "Combinar entrada + maestro"
    },
    {
      "parameters": {
        "jsCode": "const all=$input.all().map(i=>i.json);\nconst incoming=all.find(x=>x._origen==='entrada') || all[0] || {};\nconst master=all.filter(x=>x._origen!=='entrada' && x.email);\nconst required=[];\nif(!incoming.nombre) required.push('nombre');\nif(!incoming.email) required.push('email');\nif(!incoming.empresa) required.push('empresa');\nif(!incoming.nit) required.push('NIT');\nconst emailOk=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(incoming.email||'');\nconst duplicate=master.some(m=>String(m.email||'').trim().toLowerCase()===incoming.email);\nlet clasificacion='VALIDO';\nlet motivo='Registro válido';\nif(required.length){clasificacion='RECHAZADO';motivo=`Campos obligatorios ausentes: ${required.join(', ')}`;}\nelse if(!emailOk){clasificacion='RECHAZADO';motivo='Email con estructura inválida';}\nelse if((incoming.telefono||'').length<10){clasificacion='REQUIERE_REVISION';motivo='Teléfono con menos de 10 dígitos';}\nelse if(duplicate){clasificacion='DUPLICADO';motivo='Email existente en Clientes_Maestro';}\nreturn [{json:{...incoming,clasificacion,motivo,fecha_procesamiento:new Date().toISOString()}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
