        80
      ],
      "id": "083e2453-bb08-49f2-a97e-59ad69176b73",
      "name": "Calcular KPIs Ventas"
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json); const today=new Date().toISOString().slice(0,10); let abiertos=0,cerrados=0,vencidos=0; for(const r of rows){const d=String(r.fecha||r.Fecha||'').slice(0,10); if(d!==today) continue; const e=String(r.estado||r.Estado||'').toUpperCase(); if(e==='ABIERTO') abiertos++; if(e==='CERRADO') cerrados++; const v=String(r.vencido||r.Vencido||'').toUpperCase(); if(v==='SI'||v==='TRUE') vencidos++; } return [{json:{origen:'Soporte',tickets_abiertos:abiertos,tickets_cerrados:cerrados,tickets_vencidos:vencidos}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        352
      ],
      "id": "cac06ee4-c671-4496-95bb-ae58bc224d29",
      "name": "Calcular KPIs Soporte"
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json); const today=new Date().toISOString().slice(0,10); let ejecutados=0,fallidos=0; for(const r of rows){const d=String(r.fecha||r.Fecha||'').slice(0,10); if(d!==today) continue; const e=String(r.estado||r.Estado||'').toUpperCase(); if(e==='EJECUTADO'||e==='EXITOSO') ejecutados++; if(e==='FALLIDO'||e==='ERROR') fallidos++; } return [{json:{origen:'Operaciones',procesos_ejecutados:ejecutados,procesos_fallidos:fallidos}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
