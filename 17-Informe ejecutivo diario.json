    {
      "parameters": {
        "jsCode": "const a=$input.all().map(x=>x.json); const out={fecha:new Date().toISOString().slice(0,10),valor_ventas:0,negocios_cerrados:0,tickets_abiertos:0,tickets_cerrados:0,tickets_vencidos:0,procesos_ejecutados:0,procesos_fallidos:0}; for(const x of a){for(const k of Object.keys(out)){if(k!=='fecha' && typeof x[k]==='number') out[k]+=x[k];}} return [{json:out}];"
