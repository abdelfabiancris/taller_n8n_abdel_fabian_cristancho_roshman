    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json);\nconst today=new Date().toISOString().slice(0,10);\nlet valor=0,cerrados=0;\nfor(const r of rows){const d=String(r.fecha||r.Fecha||'').slice(0,10); if(d!==today) continue; const estado=String(r.estado||r.Estado||'').toUpperCase(); const v=Number(r.valor||r.Valor||0); if(estado==='CERRADO'){cerrados++; valor+=isNaN(v)?0:v;}}\nreturn [{json:{origen:'Ventas',valor_ventas:valor,negocios_cerrados:cerrados}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
