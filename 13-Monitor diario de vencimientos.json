              "name": "clasificacion",
              "value": "={{ (() => {   const fecha = String($json[\"fecha vencimiento\"] || \"\").trim();   if (!fecha) return \"SIN ALERTA\";    const [d, m, y] = fecha.split(\"/\");   const venc = new Date(Number(y), Number(m) - 1, Number(d));   const hoy = new Date();   hoy.setHours(0, 0, 0, 0);    const dias = Math.ceil((venc - hoy) / 86400000);    if (dias < 0) return \"VENCIDO\";   if (dias <= 7) return \"PRÓXIMO 7\";   if (dias <= 15) return \"PRÓXIMO 15\";   if (dias <= 30) return \"PRÓXIMO 30\";   return \"SIN ALERTA\"; })() }}",
              "type": "string"
            }
          ]
        },
